{
	"name": "monkeybot",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "pnpm --filter @monkeybot/web dev",
		"check": "pnpm --filter @monkeybot/web check",
		"build": "pnpm --filter @monkeybot/web build",
		"lint": "pnpm --filter @monkeybot/web lint",
		"test": "pnpm --filter @monkeybot/web test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"eslint": "^9.31.0",
		"eslint-plugin-svelte": "^3.10.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0"
	}
}
