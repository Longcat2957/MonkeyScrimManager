# Copy to /root/monkeybot-infra/bot/runtime.env with mode 600.
# Compose supplies environment, API base URL, public web origin, and health address.

MONKEYBOT_BOT_TOKEN=replace-with-discord-bot-token
MONKEYBOT_BOT_APPLICATION_ID=000000000000000000
# Optional: limits command registration to one guild in development. Leave empty for global registration.
MONKEYBOT_BOT_DEV_GUILD_ID=

# Must exactly match MONKEYBOT_BOT_SERVICE_TOKEN in the Axum runtime file.
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-random-service-token-at-least-32-characters
MONKEYBOT_BOT_INSTANCE_ID=monkeybot-dev-1
