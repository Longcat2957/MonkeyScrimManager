# Copy to /root/monkeybot-infra/<dev|main>/bot/runtime.env with mode 600.
# Compose supplies environment, canonical Discord application ID, command scope, development guild,
# API base URL, public web origin, and health address.

MONKEYBOT_BOT_TOKEN=replace-with-discord-bot-token

# Must exactly match MONKEYBOT_BOT_SERVICE_TOKEN in the Axum runtime file.
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-random-service-token-at-least-32-characters
