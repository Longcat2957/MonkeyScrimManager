[Unit]
Description=MonkeyBot local Axum API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/MonkeyScrimManager
EnvironmentFile=%h/workspace/MonkeyScrimManager/.local/env/dev/discord.env
EnvironmentFile=%h/workspace/MonkeyScrimManager/.local/env/dev/api.env
ExecStart=%h/workspace/MonkeyScrimManager/target/debug/monkeybot-api
Restart=on-failure
RestartSec=1
TimeoutStopSec=20

[Install]
WantedBy=default.target
