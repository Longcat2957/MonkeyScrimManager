[Unit]
Description=MonkeyBot local Riot integration API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/MonkeyScrimManager
EnvironmentFile=%h/workspace/MonkeyScrimManager/.local/env/dev/riot-api.env
ExecStart=%h/workspace/MonkeyScrimManager/target/debug/monkeybot-riot-api
Restart=on-failure
RestartSec=1
TimeoutStopSec=20

[Install]
WantedBy=default.target
