# Copy to an ignored release env file on the VPS, for example /root/monkeybot-dev/deploy/dev.env.
# Keep only non-secret deployment wiring here. Secret values belong to the runtime files below.

MONKEYBOT_RELEASE_TAG=replace-with-a-40-character-commit-sha
MONKEYBOT_WEB_IMAGE=longcat1132/monkeybot-web
MONKEYBOT_API_IMAGE=longcat1132/monkeybot-api
MONKEYBOT_RIOT_API_IMAGE=longcat1132/monkeybot-riot-api
MONKEYBOT_BOT_IMAGE=longcat1132/monkeybot-bot

MONKEYBOT_PUBLIC_ORIGIN=https://dev.monkeybot.lol
MONKEYBOT_WEB_PORT=30010
MONKEYBOT_API_PORT=30020
MONKEYBOT_BOT_HEALTH_PORT=30030

# These existing Docker networks are owned by the VPS infrastructure, not this Compose project.
MONKEYBOT_EDGE_NETWORK=deploy_default
MONKEYBOT_DATA_NETWORK=deploy_data

# Repository validation uses the tracked examples. On the VPS, replace all four with absolute
# ignored paths under /root/monkeybot-infra.
MONKEYBOT_API_RUNTIME_ENV=./api/runtime.env.example
MONKEYBOT_MIGRATION_RUNTIME_ENV=./api/migration.env.example
MONKEYBOT_RIOT_RUNTIME_ENV=./riot-api/runtime.env.example
MONKEYBOT_BOT_RUNTIME_ENV=./bot/runtime.env.example
