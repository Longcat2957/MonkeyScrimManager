# Copy to an ignored release env file on the VPS, for example /root/monkeybot-dev/deploy/dev.env.
# Keep only non-secret deployment wiring here. Secret values belong to the runtime files below.

MONKEYBOT_RELEASE_TAG=replace-with-a-40-character-commit-sha
MONKEYBOT_WEB_IMAGE=longcat1132/monkeybot-web
MONKEYBOT_API_IMAGE=longcat1132/monkeybot-api
MONKEYBOT_RIOT_API_IMAGE=longcat1132/monkeybot-riot-api
MONKEYBOT_BOT_IMAGE=longcat1132/monkeybot-bot
# Full releases use MONKEYBOT_RELEASE_TAG for every image. A compatible component hotfix
# may pin only the changed service below; leave these unset for the normal release path.
# MONKEYBOT_WEB_IMAGE_TAG=replace-with-a-40-character-commit-sha
# MONKEYBOT_API_IMAGE_TAG=replace-with-a-40-character-commit-sha
# MONKEYBOT_RIOT_API_IMAGE_TAG=replace-with-a-40-character-commit-sha
# MONKEYBOT_BOT_IMAGE_TAG=replace-with-a-40-character-commit-sha

MONKEYBOT_PUBLIC_ORIGIN=https://dev.monkeybot.lol
MONKEYBOT_DISCORD_APPLICATION_ID=000000000000000000
MONKEYBOT_BOT_COMMAND_SCOPE=guild
MONKEYBOT_BOT_DEV_GUILD_ID=000000000000000000
MONKEYBOT_BOT_INSTANCE_ID=monkeybot-dev-1
MONKEYBOT_WEB_PORT=30010
MONKEYBOT_API_PORT=30020
MONKEYBOT_BOT_HEALTH_PORT=30030

# These existing Docker networks are owned by the VPS infrastructure, not this Compose project.
MONKEYBOT_EDGE_NETWORK=deploy_default
MONKEYBOT_DATA_NETWORK=deploy_data

# Runtime files must stay inside the dev-specific secret directory.
MONKEYBOT_API_RUNTIME_ENV=/root/monkeybot-infra/dev/api/runtime.env
MONKEYBOT_MIGRATION_RUNTIME_ENV=/root/monkeybot-infra/dev/api/migration.env
MONKEYBOT_RIOT_RUNTIME_ENV=/root/monkeybot-infra/dev/riot-api/runtime.env
MONKEYBOT_BOT_RUNTIME_ENV=/root/monkeybot-infra/dev/bot/runtime.env
