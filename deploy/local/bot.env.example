# Copy to .local/env/dev/bot.env with mode 600. Load after discord.env.
MONKEYBOT_ENV=local
MONKEYBOT_BOT_TOKEN=replace-with-dev-discord-bot-token
MONKEYBOT_BOT_API_BASE_URL=http://127.0.0.1:30020
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-shared-at-least-32-character-token
MONKEYBOT_BOT_INSTANCE_ID=monkeybot-local-dev-1
MONKEYBOT_WEB_ORIGIN=http://localhost:5173
MONKEYBOT_BOT_HEALTH_ADDR=127.0.0.1:30030
MONKEYBOT_BOT_LOG_LEVEL=info
