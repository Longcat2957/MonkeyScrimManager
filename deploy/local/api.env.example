# Copy to .local/env/dev/api.env with mode 600. Load after discord.env.
MONKEYBOT_ENV=local
MONKEYBOT_DUMMY_USERS_ENABLED=true
MONKEYBOT_BIND_ADDR=127.0.0.1:30020
MONKEYBOT_PUBLIC_ORIGIN=http://localhost:5173
MONKEYBOT_LOG_FILTER=monkeybot_api=info
MONKEYBOT_REQUEST_TIMEOUT_MS=10000
MONKEYBOT_SHUTDOWN_TIMEOUT_MS=20000
MONKEYBOT_MAX_BODY_BYTES=16777216

MONKEYBOT_DATABASE_URL=postgresql://monkeybot_runtime_dev:replace-with-runtime-password@127.0.0.1:15432/monkeybot_dev?sslmode=disable
MONKEYBOT_DISCORD_CLIENT_SECRET=replace-with-dev-discord-client-secret
MONKEYBOT_OAUTH_ENCRYPTION_KEY=replace-with-base64url-no-pad-32-byte-key
MONKEYBOT_SESSION_TTL_SECONDS=604800
MONKEYBOT_SERVICE_ADMIN_IDS=replace-with-service-admin-discord-id
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-shared-at-least-32-character-token
