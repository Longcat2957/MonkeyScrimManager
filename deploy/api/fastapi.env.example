# Copy outside the repository or to an ignored *.local file. Use an isolated, migrated DB.
# A Docker container's localhost is not the host's localhost. Supply a reachable private DB host.
MONKEYBOT_ENV=local
MONKEYBOT_PUBLIC_ORIGIN=http://localhost:5173
MONKEYBOT_DATABASE_URL=postgresql://candidate_runtime:replace-password@private-db-host:5432/candidate_db?sslmode=require
MONKEYBOT_DISCORD_APPLICATION_ID=123456789012345678
MONKEYBOT_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
MONKEYBOT_OAUTH_ENCRYPTION_KEY=replace-with-base64url-no-padding-32-byte-key
# Optional; use the same service token as the existing Bot (minimum 32 characters).
# MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-existing-bot-service-token
MONKEYBOT_SERVICE_ADMIN_IDS=
# Omit MONKEYBOT_VALKEY_URL when no Valkey is configured. Readiness is then degraded/200.
