# Copy to runtime.env and replace the password. The runtime role must not own schema objects.
MONKEYBOT_DATABASE_URL=postgresql://monkeybot_runtime_dev:replace-with-runtime-password@postgres:5432/monkeybot_dev?sslmode=disable

# Discord OAuth/session. Keep the real values only in the ignored runtime.env file.
# Generate the encryption key with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
MONKEYBOT_DISCORD_CLIENT_ID=replace-with-discord-application-id
MONKEYBOT_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
MONKEYBOT_OAUTH_ENCRYPTION_KEY=replace-with-base64url-no-pad-32-byte-key
MONKEYBOT_SESSION_TTL_SECONDS=604800
MONKEYBOT_SERVICE_ADMIN_IDS=

# Optional Bot -> Axum service authentication. Keep the real token only in runtime.env.
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-at-least-32-character-token
