# Copy to /root/monkeybot-infra/api/runtime.env and set mode 600. The runtime role must not own
# schema objects. Compose supplies the private Valkey and Riot service URLs.
MONKEYBOT_DATABASE_URL=postgresql://monkeybot_runtime_dev:replace-with-runtime-password@monkeybot-postgres:5432/monkeybot_dev?sslmode=disable

# Discord OAuth/session. Keep the real values only in the ignored runtime.env file.
# Generate the encryption key with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
MONKEYBOT_DISCORD_CLIENT_ID=replace-with-discord-application-id
MONKEYBOT_DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
MONKEYBOT_OAUTH_ENCRYPTION_KEY=replace-with-base64url-no-pad-32-byte-key
MONKEYBOT_SESSION_TTL_SECONDS=604800
# Development deploys expose service-admin-only dummy data tools. Set the Discord ID of the
# MonkeyBot operator here; use comma-separated IDs only when there is more than one.
MONKEYBOT_SERVICE_ADMIN_IDS=replace-with-service-admin-discord-id

# Bot -> Axum service authentication. Keep the real token only in runtime.env.
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-at-least-32-character-token

# Private Axum -> Riot integration service authentication. This is not the Riot developer key;
# Compose supplies the private service URL.
MONKEYBOT_RIOT_SERVICE_TOKEN=replace-with-shared-at-least-32-character-internal-token
