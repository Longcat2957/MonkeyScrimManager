# Copy to /root/monkeybot-infra/riot-api/runtime.env and set mode 600. This file belongs only to
# the private Riot integration service. Never mount it into frontend, Axum, bot, migration, or
# PostgreSQL containers.
MONKEYBOT_RIOT_API_KEY=replace-with-riot-production-or-development-key
MONKEYBOT_RIOT_INTERNAL_TOKEN=replace-with-shared-at-least-32-character-internal-token
MONKEYBOT_RIOT_REQUEST_TIMEOUT_MS=5000
MONKEYBOT_RIOT_MATCH_COUNT=10
MONKEYBOT_RIOT_SEASON_START_UNIX_SECONDS=1767841200
