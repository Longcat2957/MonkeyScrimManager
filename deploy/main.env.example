# Copy to an ignored release env file on the VPS, for example /root/monkeybot-main/deploy/main.env.
# Keep only non-secret deployment wiring here. Secret values belong to the runtime files below.

MONKEYBOT_RELEASE_TAG=replace-with-a-40-character-commit-sha
MONKEYBOT_WEB_IMAGE=longcat1132/monkeybot-web
MONKEYBOT_API_IMAGE=longcat1132/monkeybot-api
MONKEYBOT_RIOT_API_IMAGE=longcat1132/monkeybot-riot-api
MONKEYBOT_BOT_IMAGE=longcat1132/monkeybot-bot

MONKEYBOT_PUBLIC_ORIGIN=https://monkeybot.lol
MONKEYBOT_DISCORD_APPLICATION_ID=000000000000000000
MONKEYBOT_BOT_COMMAND_SCOPE=global
MONKEYBOT_BOT_DEV_GUILD_ID=
MONKEYBOT_BOT_INSTANCE_ID=monkeybot-main-1
MONKEYBOT_WEB_PORT=20010
MONKEYBOT_API_PORT=20020
# The health endpoint is loopback-only and is not routed through nginx.
MONKEYBOT_BOT_HEALTH_PORT=20030

# These existing Docker networks are owned by the VPS infrastructure, not this Compose project.
MONKEYBOT_EDGE_NETWORK=deploy_default
MONKEYBOT_DATA_NETWORK=deploy_data

# Main accepts only absolute, mode-600 secret file paths under /root/monkeybot-infra/main.
MONKEYBOT_API_RUNTIME_ENV=/root/monkeybot-infra/main/api/runtime.env
MONKEYBOT_MIGRATION_RUNTIME_ENV=/root/monkeybot-infra/main/api/migration.env
MONKEYBOT_RIOT_RUNTIME_ENV=/root/monkeybot-infra/main/riot-api/runtime.env
MONKEYBOT_BOT_RUNTIME_ENV=/root/monkeybot-infra/main/bot/runtime.env
