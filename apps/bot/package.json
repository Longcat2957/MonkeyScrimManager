{
	"name": "@monkeybot/bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "prettier --check package.json tsconfig.json tsconfig.build.json \"src/**/*.ts\" && eslint src",
		"test": "vitest run",
		"commands:register:guild": "tsx src/register-commands.ts guild",
		"commands:register:global": "tsx src/register-commands.ts global"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"discord.js": "^14.22.1",
		"dotenv": "^17.2.3",
		"pino": "^10.1.0",
		"zod": "^4.0.5"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.23.0",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
