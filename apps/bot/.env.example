# Transitional standalone Bot example. The local wrapper uses deploy/local/discord.env.example and
# deploy/local/bot.env.example as separate files.
MONKEYBOT_ENV=local

# Discord application. Never commit the real token.
MONKEYBOT_BOT_TOKEN=replace-with-discord-bot-token
MONKEYBOT_DISCORD_APPLICATION_ID=000000000000000000
MONKEYBOT_BOT_COMMAND_SCOPE=guild
MONKEYBOT_BOT_DEV_GUILD_ID=000000000000000000

# Axum service-principal access. This is not the Discord bot token.
MONKEYBOT_BOT_API_BASE_URL=http://127.0.0.1:30020
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-random-service-token-at-least-32-characters
MONKEYBOT_BOT_INSTANCE_ID=monkeybot-local-1
MONKEYBOT_WEB_ORIGIN=http://localhost:5173

MONKEYBOT_BOT_HEALTH_ADDR=127.0.0.1:30030
MONKEYBOT_BOT_API_TIMEOUT_MS=10000
MONKEYBOT_BOT_HEARTBEAT_INTERVAL_MS=30000
MONKEYBOT_BOT_NOTIFICATION_POLL_INTERVAL_MS=1000
MONKEYBOT_BOT_LOG_LEVEL=info
