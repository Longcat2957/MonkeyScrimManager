# Local web runtime. Vite loads the repository-root .env/.env.local via apps/web's envDir.
# Copy secrets only to ignored .env.local; production values live in deploy/web/.env.
PUBLIC_APP_NAME=MonkeyBot
PUBLIC_WEB_ORIGIN=http://localhost:5173
PORT=3000
HOST=0.0.0.0
ORIGIN=http://localhost:3000

# Same-origin proxy targets
API_BASE_URL=http://127.0.0.1:30020/api/
OAUTH_BASE_URL=http://127.0.0.1:30020/
DATA_DRAGON_BASE_URL=https://ddragon.leagueoflegends.com

# Rust/Axum API runtime
MONKEYBOT_ENV=local
MONKEYBOT_BIND_ADDR=127.0.0.1:30020
MONKEYBOT_PUBLIC_ORIGIN=http://localhost:5173
MONKEYBOT_LOG_FILTER=monkeybot_api=info
MONKEYBOT_REQUEST_TIMEOUT_MS=10000
MONKEYBOT_SHUTDOWN_TIMEOUT_MS=20000
MONKEYBOT_MAX_BODY_BYTES=1048576

# Local processes reach the VPS development database through scripts/vps-db-tunnel.sh.
MONKEYBOT_DATABASE_URL=postgresql://monkeybot_runtime_dev:replace-with-runtime-password@127.0.0.1:15432/monkeybot_dev?sslmode=disable
MONKEYBOT_MIGRATION_DATABASE_URL=postgresql://monkeybot_migrator_dev:replace-with-migration-password@127.0.0.1:15432/monkeybot_dev?sslmode=disable

# Discord OAuth/session. The callback URI is derived as
# MONKEYBOT_PUBLIC_ORIGIN + /oauth/callback.
# Never commit real client secrets or encryption keys.
MONKEYBOT_DISCORD_CLIENT_ID=000000000000000000
MONKEYBOT_DISCORD_CLIENT_SECRET=replace-with-local-secret
MONKEYBOT_OAUTH_ENCRYPTION_KEY=replace-with-base64url-no-pad-32-byte-key
MONKEYBOT_SESSION_TTL_SECONDS=604800
MONKEYBOT_SERVICE_ADMIN_IDS=123456789012345678

# Optional Bot -> Axum service authentication. Use a random value of at least 32 characters.
MONKEYBOT_BOT_SERVICE_TOKEN=replace-with-at-least-32-character-token

# Axum -> private Riot integration service. The service token must match that service's
# MONKEYBOT_RIOT_INTERNAL_TOKEN; the Riot developer key never belongs to Axum or web.
MONKEYBOT_RIOT_SERVICE_URL=http://127.0.0.1:30040/internal/riot/
MONKEYBOT_RIOT_SERVICE_TOKEN=replace-with-shared-at-least-32-character-internal-token

# Separate Riot integration service runtime. Only this process receives the Riot developer key.
MONKEYBOT_RIOT_BIND_ADDR=127.0.0.1:30040
MONKEYBOT_RIOT_API_KEY=replace-with-riot-development-key
MONKEYBOT_RIOT_INTERNAL_TOKEN=replace-with-shared-at-least-32-character-internal-token
MONKEYBOT_RIOT_REQUEST_TIMEOUT_MS=5000
MONKEYBOT_RIOT_MATCH_COUNT=10
# 2026 annual ranked season start: 2026-01-08 12:00 KST (UTC epoch seconds).
MONKEYBOT_RIOT_SEASON_START_UNIX_SECONDS=1767841200
