# Web runtime
PUBLIC_APP_NAME=MonkeyBot
PUBLIC_WEB_ORIGIN=http://localhost:5173
PORT=3000
HOST=0.0.0.0
ORIGIN=http://localhost:3000

# Same-origin proxy targets
API_BASE_URL=http://localhost:8787
OAUTH_BASE_URL=http://localhost:8787
DATA_DRAGON_BASE_URL=https://ddragon.leagueoflegends.com

# Discord OAuth placeholders. Do not put secrets in committed env files.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-with-local-secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Cloudflare D1 / Drizzle placeholders.
# D1 remote access will be wired during backend/db implementation.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id
CLOUDFLARE_API_TOKEN=replace-with-local-secret
DATABASE_URL=file:./local-dev.sqlite
